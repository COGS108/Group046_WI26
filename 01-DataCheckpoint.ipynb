"source": [
    "import pandas as pd\n",
        "import io\n",
        "import requests\n",
        "\n",
        "#load data\n",
        "url = \"https://raw.githubusercontent.com/COGS108/Group046_WI26/72efcfcfe6ea229d895a0e93db5f02fc74ef297c/data/00-raw/Recreation%20Visitors%20By%20Month%20(1979%20-%20Last%20Calendar%20Year).csv\"\n",
        "s = requests.get(url).content\n",
        "\n",
        "#data cleaning (getting rid of non-data rows and columns)\n",
        "#remove \"LabelName\" and \"Yosemite NP\" lines and \"Textbox5\" column\n",
        "df = pd.read_csv(io.StringIO(s.decode('utf-8')), skiprows=2)\n",
        "df = df.drop(columns=['Textbox5'])\n",
        "\n",
        "#wrangle columns\n",
        "month_cols = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC']\n",
        "for col in month_cols:\n",
        "    df[col] = df[col].astype(str).str.replace(',', '').replace('nan', '0')\n",
        "    df[col] = pd.to_numeric(df[col], errors='coerce').fillna(0).astype(int)\n",
        "\n",
        "# switch to reading lengthwise instead of widthwise\n",
        "df_tidy = df.melt(id_vars=['Year'],\n",
        "                  value_vars=month_cols,\n",
        "                  var_name='Month',\n",
        "                  value_name='Visitors')\n",
        "\n",
        "month_map = {'JAN':1, 'FEB':2, 'MAR':3, 'APR':4, 'MAY':5, 'JUN':6,\n",
        "             'JUL':7, 'AUG':8, 'SEP':9, 'OCT':10, 'NOV':11, 'DEC':12}\n",
        "df_tidy['Month_Num'] = df_tidy['Month'].map(month_map)\n",
        "df_tidy['Date'] = pd.to_datetime(df_tidy[['Year']].assign(Month=df_tidy['Month_Num'], Day=1))\n",
        "#exclude 2026\n",
        "df_tidy = df_tidy[df_tidy['Year'] != 2026].copy()\n",
        "\n",
        "# 1. Size of dataset\n",
        "print(f'Shape: {df_tidy.shape}')\n",
        "print(f'Date range: {df_tidy[\"Date\"].min().date()} to {df_tidy[\"Date\"].max().date()}')\n",
        "\n",
        "# 2. Tidiness check\n",
        "print(f'\\nDuplicate month/year combos: {df_tidy[[\"Year\", \"Month\"]].duplicated().sum()}')\n",
        "\n",
        "# 3. Missingness\n",
        "print('\\nMissing values per column:')\n",
        "print(df_tidy.isnull().sum())\n",
        "\n",
        "# 4. Missing calendar months\n",
        "# Check for gaps between 1979 and the most recent year\n",
        "expected_months = pd.date_range(start='1979-01-01', end=df_tidy['Date'].max(), freq='MS')\n",
        "missing_months = expected_months.difference(df_tidy['Date'])\n",
        "print(f'\\nCalendar months with no visitor data: {len(missing_months)}')\n",
        "if len(missing_months) > 0:\n",
        "    print(f'Missing periods: {missing_months}')\n",
        "\n",
        "# 5. Outliers\n",
        "print('\\nVisitor count summary statistics:')\n",
        "print(df_tidy['Visitors'].describe())\n",
        "# outlier: exceptionally low month (<50k visitors)\n",
        "low_traffic = df_tidy[df_tidy['Visitors'] < 50000]\n",
        "print(f'\\nMonths with < 50,000 Visitors: {len(low_traffic)}')\n",
        "print(low_traffic[['Date', 'Visitors']])\n",
        "\n",
        "# 6. Seasonality breakdown\n",
        "avg_by_month = df_tidy.groupby('Month')['Visitors'].mean().sort_values(ascending=False)\n",
        "print('\\nAverage Visitors by Month (Historical):')\n",
        "print(avg_by_month)\n",
        "\n",
        "# 7. Save cleaned file\n",
        "os.makedirs('data/02-processed', exist_ok=True)\n",
        "df_tidy.to_csv('data/02-processed/yosemite_visitors_cleaned.csv', index=False)\n",
        "print('\\nSaved to data/02-processed/yosemite_visitors_cleaned.csv')\n",
        "\n",
        "#sort values\n",
        "df_tidy = df_tidy.sort_values('Date').reset_index(drop=True)\n",
        "\n",
        "print(df_tidy.head())"
]
